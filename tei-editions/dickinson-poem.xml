  <text>
      <body>
         <head type="title">I Never Saw A Moor</head>
         <lg type="poem">
            
         <lg type="stanza">
            <l n="1">I never saw a Moor,</l>
            <l n="2">I never saw the Sea;</l>
            <l n="3">Yet know I how the Heather looks,</l>
            <l n="4">And what a Billow be.</l>
         </lg>
         
         <lg type="stanza">
            <l n="5">I never spoke with God,</l>
            <l n="6">Nor visited in Heaven;</l>
            <l n="7">Yet certain am I of the spot</l>
            <l n="8">As if the Checks were given.</l>
         </lg>
            
         </lg>
      </body>
